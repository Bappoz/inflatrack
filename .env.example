# Copie para .env. O .env não é versionado.
POSTGRES_USER=inflatrack
POSTGRES_PASSWORD=inflatrack
POSTGRES_DB=inflatrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Portas no host. Mude se já estiverem em uso por outro projeto.
# Dagster (`just orquestrador`, roda fora do Docker): http://localhost:3002
DAGSTER_PORT=3002
# Adminer (docker compose): http://localhost:8080
ADMINER_PORT=8080

# Chave do HMAC que transforma o CNPJ em hash_estabelecimento no CDC (LGPD). Sem ela, um SHA-256
# puro seria revertido por força bruta (são poucos CNPJs possíveis). Troque em cada ambiente:
# mudar a chave muda todos os hashes.
CDC_CHAVE_PSEUDONIMO=troque-esta-chave-em-cada-ambiente

# Chave gratuita em https://www.alphavantage.co/support/#api-key (25 requisições/dia).
ALPHAVANTAGE_API_KEY=
# Metabase (docker compose --profile bi up -d). Interface em http://localhost:3001
# (diferente de DAGSTER_PORT). Lê só o Postgres (schema serie).
METABASE_PORT=3001
METABASE_DB_PASSWORD=metabase
# Login do Metabase usado por `just metabase-painel` (scripts/metabase_painel.py). Na primeira
# subida, o script cria este usuário; depois, entra com ele. Use uma senha forte.
METABASE_EMAIL=
METABASE_SENHA=
# Login do Postgres que o Metabase usa para ler `serie` (papel metabase_leitor, sem acesso a
# `public`). `just metabase-painel` cria o usuário e grava esta senha nele. Troque a senha.
METABASE_PG_USER=metabase_painel
METABASE_PG_PASSWORD=troque-esta-senha
