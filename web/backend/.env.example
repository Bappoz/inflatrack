SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# O site chama a API pelo próprio domínio (/api), então o CORS só importa se alguém chamar o
# backend direto. Produção: a URL pública do site, ex.: https://inflatrack.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Produção (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
# Conexão PostgreSQL do Supabase (pooler para operações da API).
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
# Conexão direta ou session pooler para aplicar o esquema.
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require
# Felicia (chamadas diretas ao proxy LiteLLM, formato OpenAI). LITELLM_MODEL é o nome
# do modelo no proxy, sem o prefixo "openai/" (esse prefixo era só da biblioteca litellm).
LITELLM_PROXY_URL=https://seu-proxy-litellm
LITELLM_API_KEY=sua-chave
LITELLM_MODEL=gpt-5.4-mini
